<launch>
  <!-- Record throttled camera topics to a bag.
       RGB throttled to 2 Hz, depth to 1 Hz. -->

  <arg name="output_path" default="/tmp/pragmabot_recording"
       doc="Bag file prefix (rosbag will append timestamp + .bag)" />
  <arg name="rgb_topic"   default="/camera/color/image_raw" />
  <arg name="depth_topic" default="/camera/depth/image_rect_raw" />
  <arg name="info_topic"  default="/camera/color/camera_info" />

  <arg name="throttled_rgb_topic"   default="/throttled/rgb" />
  <arg name="throttled_depth_topic" default="/throttled/depth" />

  <node pkg="topic_tools" type="throttle" name="throttle_rgb"
        args="messages $(arg rgb_topic) 2.0 $(arg throttled_rgb_topic)" />

  <node pkg="topic_tools" type="throttle" name="throttle_depth"
        args="messages $(arg depth_topic) 1.0 $(arg throttled_depth_topic)" />

  <node pkg="rosbag" type="record" name="rosbag_record" output="screen"
        args="/tf /tf_static $(arg info_topic) $(arg throttled_rgb_topic) $(arg throttled_depth_topic) -o $(arg output_path)" />
</launch>
