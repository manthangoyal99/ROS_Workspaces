<launch>
  <!-- Standalone LTM inspector (Gradio UI on a separate port from pragmabot_node). -->
  <arg name="config_path" default="$(find pragmabot)/config/config.yaml" />
  <arg name="venv_site_packages"
       default="$(env HOME)/pragma_ws/src/pragmabot-repro/.venv/lib/python3.8/site-packages"
       doc="Path to the venv site-packages directory to prepend to PYTHONPATH" />

  <node pkg="pragmabot" type="memory_manager_node.py" name="memory_manager_node" output="screen">
    <env name="PYTHONPATH"
         value="$(arg venv_site_packages):$(optenv PYTHONPATH)" />
    <param name="config_path" value="$(arg config_path)" />
  </node>
</launch>
