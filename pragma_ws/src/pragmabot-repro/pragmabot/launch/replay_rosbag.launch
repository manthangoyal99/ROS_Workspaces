<launch>
  <!-- Rosbag-replay mode: replay a bag, republish images on pragmabot's topics,
       and drive the pipeline with stub robot + ROS camera observations. -->

  <param name="/use_sim_time" type="bool" value="true" />

  <arg name="bag_path" doc="Required path to the rosbag file to replay" />
  <arg name="rate" default="1.0" />
  <arg name="start" default="0.0" />
  <arg name="config_path" default="$(find pragmabot)/config/config.yaml" />

  <!-- Venv site-packages path. Override on a per-machine basis if your repo or
       Python version differs from the default below. -->
  <arg name="venv_site_packages"
       default="$(env HOME)/pragma_ws/src/pragmabot-repro/.venv/lib/python3.8/site-packages"
       doc="Path to the venv site-packages directory to prepend to PYTHONPATH" />

  <!-- Topics in the recorded bag -->
  <arg name="bag_rgb_topic"   default="/camera/color/image_raw" />
  <arg name="bag_depth_topic" default="/camera/depth/image_rect_raw" />

  <!-- 1. Play the bag -->
  <node pkg="rosbag" type="play" name="rosbag_play" output="screen"
        args="--clock $(arg bag_path) -r $(arg rate) -s $(arg start)" />

  <!-- 2. Image republisher (click-gated by default; override with always_forward:=true) -->
  <node pkg="pragmabot" type="image_republisher_node.py" name="image_republisher_node"
        output="screen">
    <env name="PYTHONPATH"
         value="$(arg venv_site_packages):$(optenv PYTHONPATH)" />
    <param name="config_path" value="$(arg config_path)" />
    <param name="always_forward" value="false" />
    <param name="max_per_trigger" value="1" />
    <remap from="input/rgb"   to="$(arg bag_rgb_topic)" />
    <remap from="input/depth" to="$(arg bag_depth_topic)" />
  </node>

  <!-- 3. Main pragmabot node (config must have ros.rosbag_replay: true and robot.backend: stub) -->
  <node pkg="pragmabot" type="pragmabot_node.py" name="pragmabot_node" output="screen">
    <env name="PYTHONPATH"
         value="$(arg venv_site_packages):$(optenv PYTHONPATH)" />
    <param name="config_path" value="$(arg config_path)" />
  </node>

  <!-- 4. Visualize republished frames + manual click trigger.
            required="false" → headless machines won't die when rqt fails. -->
  <node pkg="rqt_image_view" type="rqt_image_view" name="rqt_image_view"
        required="false" output="screen" />
</launch>
